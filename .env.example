# Server-only variables. Never prefix credentials with VITE_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
APP_ORIGIN=http://127.0.0.1:5173
AUTH_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_VOICE=onyx
# Explicitly set DATABASE_URL=file:./prisma/oralia.db for local SQLite instead.
# Prisma CLI schema operations always use DATABASE_URL or local SQLite.
# Production APP_ORIGIN=https://oralia.vercel.app
# AUTH_SECRET must be a cryptographically random value of at least 32 characters.
