# Server-only variables. Never prefix credentials with VITE_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PRESENTATION_MODE=true
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
