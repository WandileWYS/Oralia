{
  "name": "oralia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "prisma generate && tsx scripts/generate-media.ts && tsc --noEmit && vite build",
    "predev": "prisma generate && tsx scripts/generate-media.ts",
    "pretest": "prisma generate && tsx scripts/generate-media.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test --test-concurrency=1 src/hooks/timeline.test.ts src/lib/education.test.ts src/lib/catalog.test.ts src/lib/api.test.ts server/api.test.ts server/collectionMigration.test.ts server/deployment.test.ts server/production.test.ts server/pipeline.test.ts server/foundry.test.ts",
    "db:deploy:turso": "tsx scripts/deploy-turso.ts",
    "db:verify:turso": "tsx scripts/verify-turso.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:migrate:turso": "tsx scripts/migrate-production-turso.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "cloudinary": "^2.11.0",
    "clsx": "2.1.1",
    "jszip": "3.10.2",
    "lucide-react": "1.69.0",
    "nitro": "^3.0.261103-rc",
    "nodemailer": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "srvx": "1.0.8",
    "tailwind-merge": "2.6.0",
    "workflow": "^5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "overrides": {
    "zod": "4.6.7",
    "undici": "7.30.1",
    "minimatch": "11.0.1"
  }
}
