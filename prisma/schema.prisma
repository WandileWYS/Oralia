generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  CREATOR
  READER
}

enum VoiceType {
  ORIGINAL
  STUDIO_AI
}

enum StoryCollection {
  FOLK_AND_FABLE
  EPIC_AND_CHRONICLE
}

model User {
  id                 String     @id @default(cuid())
  name               String
  username           String     @unique
  email              String     @unique
  avatarUrl          String
  bio                String
  role               Role       @default(READER)
  preferredVoiceType VoiceType  @default(ORIGINAL)
  stories            Story[]
  bookmarks          Bookmark[]
  sessions           Session[]
}

model Story {
  id               String          @id
  title            String
  description      String
  collection       StoryCollection
  regionTag        String
  audioUrl         String
  originalAudioUrl String?
  voiceType        VoiceType       @default(STUDIO_AI)
  duration         Float
  authorId         String
  author           User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  sourceTitle      String
  sourceUrl        String
  culturalNote     String
  featured         Boolean         @default(false)
  publishedAt      DateTime        @default(now())
  scenes           KeyframeScene[]
  bookmarks        Bookmark[]

  @@index([collection, publishedAt])
  @@index([authorId])
}

model KeyframeScene {
  id             String @id @default(cuid())
  storyId        String
  story          Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sceneNumber    Int
  title          String
  narrationText  String
  imageUrl       String
  timestamp      Float
  imageCredit    String
  imageSourceUrl String

  @@unique([storyId, sceneNumber])
}

model Bookmark {
  id      String @id @default(cuid())
  userId  String
  storyId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
}

model OtpChallenge {
  id        String   @id @default(cuid())
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
