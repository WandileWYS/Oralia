generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  CREATOR
  READER
}

enum VoiceType {
  ORIGINAL
  STUDIO_AI
}

enum StoryCollection {
  FOLK_AND_FABLE
  EPIC_AND_CHRONICLE
}

model User {
  id                 String     @id @default(cuid())
  name               String
  username           String     @unique
  email              String     @unique
  avatarUrl          String
  bio                String
  role               Role       @default(READER)
  preferredVoiceType VoiceType  @default(ORIGINAL)
  emailVerifiedAt    DateTime?
  creationJobs       CreationJob[]
  versions           StoryVersion[]
  assets             MediaAsset[]
  exports            StoryExport[]
  stories            Story[]
  bookmarks          Bookmark[]
  sessions           Session[]
}

model Story {
  id               String          @id
  title            String
  description      String
  collection       StoryCollection
  regionTag        String
  audioUrl         String
  originalAudioUrl String?
  voiceType        VoiceType       @default(STUDIO_AI)
  duration         Float
  authorId         String
  author           User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  sourceTitle      String
  sourceUrl        String
  culturalNote     String
  featured         Boolean         @default(false)
  publishedAt      DateTime        @default(now())
  versionId        String?         @unique
  provenance       String          @default("LEGACY_EDITORIAL")
  language         String          @default("en")
  scenes           KeyframeScene[]
  bookmarks        Bookmark[]

  @@index([collection, publishedAt])
  @@index([authorId])
}

model KeyframeScene {
  id             String @id @default(cuid())
  storyId        String
  story          Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sceneNumber    Int
  title          String
  narrationText  String
  imageUrl       String
  timestamp      Float
  imageCredit    String
  imageSourceUrl String

  @@unique([storyId, sceneNumber])
}

model Bookmark {
  id      String @id @default(cuid())
  userId  String
  storyId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
}

model OtpChallenge {
  id        String   @id @default(cuid())
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  codeHash  String
  attempts  Int      @default(0)
  sentAt    DateTime?
  createdAt DateTime @default(now())
  @@index([email, createdAt])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  verified  Boolean  @default(true)
}

model AuthRateLimit {
  key       String @id
  count     Int
  resetAt   DateTime
}

model CreationJob {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId        String
  version        Int      @default(1)
  requestKey     String
  inputJson      String
  transcript     String?
  planJson       String?
  status         String   @default("QUEUED")
  stage          String   @default("queued")
  errorCode      String?
  retryable      Boolean  @default(false)
  totalScenes    Int      @default(0)
  processedScenes Int     @default(0)
  notificationStatus String @default("PENDING")
  workflowRunId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assets         MediaAsset[]
  @@unique([userId, requestKey])
  @@unique([storyId, version])
  @@index([userId, createdAt])
}

model MediaAsset {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String?
  job           CreationJob? @relation(fields: [jobId], references: [id], onDelete: Restrict)
  slot          String
  publicId      String   @unique
  assetId       String?
  resourceType  String
  deliveryType  String   @default("authenticated")
  format        String?
  mimeType      String?
  bytes         Int?
  duration      Float?
  sampleCount   Int?
  checksum      String?
  status        String   @default("RESERVED")
  createdAt     DateTime @default(now())
  @@unique([jobId, slot])
}

model StoryVersion {
  id          String   @id @default(cuid())
  storyId     String
  number      Int
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId       String   @unique
  snapshotJson String
  createdAt   DateTime @default(now())
  publishedAt DateTime?
  @@unique([storyId, number])
}

model StoryExport {
  id             String @id @default(cuid())
  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionId      String
  status         String @default("QUEUED")
  assetPublicId  String? @unique
  notificationStatus String @default("NOT_REQUESTED")
  recipient      String?
  errorCode      String?
  workflowRunId  String?
  createdAt      DateTime @default(now())
  @@unique([userId, versionId])
}
