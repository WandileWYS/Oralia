{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "excludeFiles": "{.env,.env.*,.qa/**,prisma/*.db*,public/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__oralia_path=$1" },
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)|media(?:/|$)|images(?:/|$)|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
